<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>

  <appSettings>
    <!-- Base URL of the .NET 8 Icegate.Integration API (NOT an ICEGATE URL). -->
    <add key="OurApiBaseUrl" value="https://localhost:5001" />

    <!-- Internal API key issued for THIS legacy application. Never the ICEGATE API key. -->
    <add key="OurApiKey" value="local-dev-internal-key-change-me" />

    <!-- Optional metadata sent with the upload. -->
    <add key="IcegateId" value="" />
    <add key="SenderId" value="SRAVANCFS" />

    <!-- Request timeout, in milliseconds. -->
    <add key="RequestTimeoutMs" value="120000" />
  </appSettings>

  <system.net>
    <!-- TLS 1.2 must be explicitly enabled on .NET Framework 4.0 - see IcegateApiClient static constructor. -->
    <settings>
      <httpWebRequest useUnsafeHeaderParsing="false" />
    </settings>
  </system.net>
</configuration>
